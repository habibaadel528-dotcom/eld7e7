# ── Server Environment Variables ──
# انسخ هذا الملف وسمّه .env للتطوير المحلي
# على Railway أضف هذه المتغيرات في قسم Variables

# ── Database ──
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/eld7e7

# ── Auth ──
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── CORS (Frontend URL on Vercel) ──
CLIENT_ORIGIN=https://your-frontend.vercel.app

# ── Email (Resend or SMTP) ──
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=El-D7E7 <orders@eld7e7.com>

# ── Cloudinary (Persistent Image Storage — FREE, no Visa needed) ──
# إنشاء حساب مجاني: https://cloudinary.com/users/register/free
# بعد التسجيل ستجد هذه القيم في: Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Server Port (Railway يضبطها تلقائياً) ──
PORT=5000
